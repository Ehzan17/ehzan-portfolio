generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String    @id @default(uuid())
  token     String    @unique
  expiresAt DateTime
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id               String              @id @default(uuid())
  title            String
  slug             String              @unique
  subtitle         String?
  shortDescription String
  fullDescription  String?
  category         String?
  status           ProjectStatus       @default(DRAFT)
  featured         Boolean             @default(false)
  displayOrder     Int                 @default(0)
  repositoryUrl    String?
  demoUrl          String?
  technologies     ProjectTechnology[]
  images           ProjectImage[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, featured, displayOrder])
}

model Technology {
  id       String              @id @default(uuid())
  name     String              @unique
  projects ProjectTechnology[]
  skills   Skill[]
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model Skill {
  id           String      @id @default(uuid())
  name         String
  category     String
  displayOrder Int         @default(0)
  proficiency  String?
  technologyId String?
  technology   Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model MediaAsset {
  id        String   @id @default(uuid())
  path      String   @unique
  alt       String?
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Profile {
  id          String  @id @default(uuid())
  displayName String  @default("EHZAN")
  title       String
  biography   String?
  location    String  @default("Kerala, India")
  email       String?
  githubUrl   String?
  gitlabUrl   String?
  linkedinUrl String?
  availability String?
}
